# Dataset de imágenes (154 MB) — se descarga de Kaggle, ver README.
# https://www.kaggle.com/datasets/hamdallak/the-iqothnccd-lung-cancer-dataset
Datos/

# Estado de entrenamiento en vivo (JSON) y logs — se regeneran solos
# cada vez que se lanza un entrenamiento desde alguna de las apps web.
outputs/progress/

# Modelos del protocolo corregido (correcciones tutora): decenas de runs
# (5 escenarios x hasta 3 semillas) pesarían varios cientos de MB en total.
# Se suben predicciones/historiales/CSV/JSON/figuras (lo que hace falta
# para el documento), no los pesos — reproducibles reejecutando entrenar().
outputs/experimentos/runs/*/modelo.keras
outputs/experimentos/runs/*/modelo.joblib
outputs/experimentos/runs_descartados_schedule/*/modelo.keras
outputs/experimentos/runs_descartados_schedule/*/modelo.joblib

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
